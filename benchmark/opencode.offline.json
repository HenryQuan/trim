{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": { "*": "deny" },
    "bash": {
      "*": "allow",
      "curl": "deny",
      "curl *": "deny",
      "wget": "deny",
      "wget *": "deny",
      "python": "deny",
      "python *": "deny",
      "python3": "deny",
      "python3 *": "deny",
      "py": "deny",
      "py *": "deny",
      "node": "deny",
      "node *": "deny",
      "npm": "deny",
      "npm *": "deny",
      "npx": "deny",
      "npx *": "deny",
      "pip": "deny",
      "pip *": "deny",
      "pip3": "deny",
      "pip3 *": "deny",
      "uv": "deny",
      "uv *": "deny",
      "uvx": "deny",
      "uvx *": "deny",
      "git fetch": "deny",
      "git fetch *": "deny",
      "git pull": "deny",
      "git pull *": "deny",
      "git clone": "deny",
      "git clone *": "deny",
      "git ls-remote": "deny",
      "git ls-remote *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "trim curl": "deny",
      "trim curl *": "deny",
      "trim wget": "deny",
      "trim wget *": "deny",
      "trim python": "deny",
      "trim python *": "deny",
      "trim python3": "deny",
      "trim python3 *": "deny",
      "trim node": "deny",
      "trim node *": "deny",
      "trim npm *": "deny",
      "trim npx *": "deny",
      "trim pip *": "deny",
      "trim uv *": "deny",
      "trim uvx *": "deny",
      "trim git fetch *": "deny",
      "trim git pull *": "deny",
      "trim git clone *": "deny",
      "trim git ls-remote *": "deny",
      "trim git push *": "deny"
    }
  }
}
